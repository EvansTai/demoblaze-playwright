# Copy this file to .env to override the default settings.
BASE_URL=https://www.demoblaze.com
API_URL=https://api.demoblaze.com
# Password for test accounts created automatically.
TEST_PASSWORD=Test@123
# Maximum page load time in milliseconds for all performance checks.
PERF_MAX_LOAD_MS=8000
# Keep the worker count low to limit concurrent requests to the shared demo site.
WORKERS=2
